---
import Layout from "../layouts/Layout.astro";
import ThreeScene from "../components/ThreeScene.astro";
---
 <!-- Alle længere tekster er skrevet af en AI -->
 <!-- Ting lavet med Ai markere jeg med en "🤖" -->

<Layout>
  <main class="p-5 bg-[#EFEEEE] max-w-xl mx-auto">

    <h1 class="font-heading text-3xl text-[#26264C] font-bold leading-tight">
      DroneFGN26 - Vores<br />Grønne Teknologisk<br />Udviklingsprojekt
    </h1>

     <!-- Hvem er vi-->
    <h2 class="font-heading text-3xl mt-6 text-[#26264C] font-bold">
      Hvad er DroneFGN26?
    </h2>
    
    <!--🤖--> <p class="font-body mt-2 text-sm text-[#26264C] leading-relaxed">  
      DroneFGN26 er et teknologisk udviklingsprojekt med fokus på design og implementering af koordinerede droneshows
      som et bæredygtigt alternativ til traditionelt fyrværkeri. Projektet arbejder med autonome multirotor-droner,
      der via centraliseret styring, positionsdata (GNSS) og realtidskommunikation kan udføre præcise formationer og
      lyssekvenser i luftrummet. Systemet er udviklet med energieffektivitet, genanvendelige komponenter og støjreduktion
      som centrale parametre.
    </p>

    <!-- DRONE SEKTION -->
    <section class="mt-4 rounded-2xl border border-[#26264C]/15 bg-[#EFEEEE] p-4 shadow-sm">
      <div class="flex flex-wrap justify-center gap-2 mb-3">
        <button id="btn-lazor" class="mode-btn-top font-ui h-9 px-3 rounded-md bg-[#E3A14B] text-[#26264C] text-sm font-medium border border-[#26264C]/20 shadow-sm">
          Laser Unit
        </button>
        <button id="btn-ring" class="mode-btn-top font-ui h-9 px-3 rounded-md bg-[#E3A14B] text-[#26264C] text-sm font-medium border border-[#26264C]/20 shadow-sm">
         Gyrobånd
        </button>
        <button id="btn-arme" class="mode-btn-top font-ui h-9 px-3 rounded-md bg-[#E3A14B] text-[#26264C] text-sm font-medium border border-[#26264C]/20 shadow-sm">
         Frame arms
        </button>
        <button id="btn-luft" class="mode-btn-top font-ui h-9 px-3 rounded-md bg-[#E3A14B] text-[#26264C] text-sm font-medium border border-[#26264C]/20 shadow-sm">
          Lufttrykker
        </button>
      </div>

       
  <!-- Scene 1 -->
<div class="relative">
  <ThreeScene containerId="three-top" />

  <!-- Tilbage knap -->
  <button
    id="btn-reset"
    class="font-ui absolute bottom-3 right-3 h-10 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm"
    type="button"
  >
    Tilbage
  </button>
</div>
    </section>
    <!-- Knapper til partikelsystem-->
    <h2 class="font-heading text-3xl mt-8 text-[#26264C] font-bold">
      DroneFGN26 i action
    </h2>

    <section class="mt-4 rounded-2xl border border-[#26264C]/15 bg-[#EFEEEE] p-4 shadow-sm">
      <div class="flex flex-wrap justify-center gap-2 mb-3">
        <button id="btn-torus" class="mode-btn-bottom font-ui h-9 px-3 rounded-md bg-[#E3A14B] text-[#26264C] text-sm font-medium border border-[#26264C]/20 shadow-sm">
          Donut
        </button>
        <button id="btn-sphere" class="mode-btn-bottom font-ui h-9 px-3 rounded-md bg-[#E3A14B] text-[#26264C] text-sm font-medium border border-[#26264C]/20 shadow-sm">
          Kugle
        </button>
        <button id="btn-knot" class="mode-btn-bottom font-ui h-9 px-3 rounded-md bg-[#E3A14B] text-[#26264C] text-sm font-medium border border-[#26264C]/20 shadow-sm">
          Knude
        </button>
        <button id="btn-firkant" class="mode-btn-bottom font-ui h-9 px-3 rounded-md bg-[#E3A14B] text-[#26264C] text-sm font-medium border border-[#26264C]/20 shadow-sm">
          Firkant
        </button>
      </div>

       
      

      <!-- Scene 2 -->
      <div class="relative">
        <ThreeScene containerId="three-bottom" />

        <!-- Stor skærm knap -->
        <button
          id="btn-fullscreen"
          class="font-ui absolute bottom-3 right-3 h-10 px-3 rounded-md
                 bg-[#E3A14B] text-[#26264C] text-sm font-medium
                 border border-[#26264C]/20 shadow-sm"
          type="button"
        >
          Stor skærm
        </button>
      </div>
    </section>

    <script is:inline>
   
  // beskrivelser af de forskellige dele
      const topButtons = document.querySelectorAll(".mode-btn-top");
      const titleEl = document.getElementById("mode-title");
      const textEl = document.getElementById("mode-text");

      const topCopy = {
        "btn-lazor": { title: "Laser", text: "Den højeffektive lyslaser skaber skarpe, klare lysfigurer på himlen, som kan ses fra flere kilometers afstand. I modsætning til fyrværkeri kræver den ingen eksplosive materialer og udleder hverken røg, partikler eller tungmetaller. Ét droneshow kan derfor opleves af langt flere mennesker – uden støj, affald eller brandrisiko."
  },
        "btn-ring":  { title: "Gyrobånd",  text: "Den stabiliserede rotationsring gør det muligt for laseren at rotere 360 grader, mens lysbilledet forbliver præcist og korrekt orienteret. Det sikrer rolige, kontrollerede animationer på himlen – helt uden de ukontrollerbare bevægelser og tilfældige eksplosioner, man kender fra fyrværkeri."
  },

        "btn-arme":  { title: "Frame", text: "Dronens arme er fremstillet af et 100 % genanvendeligt letvægtsmetal, som reducerer energiforbruget og forlænger flyvetiden. Materialevalget gør dronen både stærk og bæredygtig – i modsætning til engangs-fyrværkeri, der efterlader affald uden mulighed for genbrug."
  },

        "btn-luft":  { title: "Lufttrykker", text: "Det adaptive lufttrykssystem anvender kontrolleret lufttryk til at stabilisere dronen i alle retninger – også uden brug af kraftige rotorer. Systemet fungerer desuden som en indbygget sikkerhedsmekanisme: Skulle dronen miste strøm eller blive beskadiget, skaber lufttrykket modstand og bremser faldet, så risikoen for tilskuere minimeres. En sikkerhed, som traditionelt fyrværkeri slet ikke kan tilbyde.." },
      };

      function markActive(btns, active) {
        btns.forEach(b => {
          b.classList.remove("bg-[#EEB770]");
          b.classList.add("bg-[#E3A14B]");
        });
        active.classList.remove("bg-[#E3A14B]");
        active.classList.add("bg-[#EEB770]");
      }

      topButtons.forEach(btn => {
        btn.addEventListener("click", () => {
          const info = topCopy[btn.id];
          if (info && titleEl && textEl) {
            titleEl.textContent = info.title;
            textEl.textContent = info.text;
          }
          markActive(topButtons, btn);
        });
      });

      // ---  UI  ---
      const bottomButtons = document.querySelectorAll(".mode-btn-bottom");
      bottomButtons.forEach(btn => {
        btn.addEventListener("click", () => {
          markActive(bottomButtons, btn);
        });
      });

      // --- Stor skærm: fullscreen på nederste container ---
      const fsBtn = document.getElementById("btn-fullscreen");
      const bottomContainer = document.getElementById("three-bottom");

      fsBtn?.addEventListener("click", async () => {
        if (!bottomContainer) return;

        // standard fullscreen API
        if (document.fullscreenElement) {
          await document.exitFullscreen();
        } else {
          await bottomContainer.requestFullscreen?.();
        }
      });
    </script>

    <!-- Start 2 scenes -->
<script>
  import { startDroneScene } from "../scripts/three-drone.js";

  const initScenes = () => {
    const top = document.getElementById("three-top");
    const bottom = document.getElementById("three-bottom");

    if (top) startDroneScene(top, { mode: "drone" });
    if (bottom) startDroneScene(bottom, { mode: "particles" });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initScenes);
  } else {
    initScenes();
  }
</script>

  </main>
</Layout>
