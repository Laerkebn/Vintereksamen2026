---
import Layout from "../layouts/Layout.astro";
import ThreeScene from "../components/ThreeScene.astro";
---

<Layout>
  <main class="p-5 bg-[#EFEEEE]">

    <h1 class="font-heading text-2xl text-[#26264C] p-3 font-bold">
      DroneFGN26 - Vores Grønne Teknologisk Udviklingsprojekt    </h1>

    <!-- bagrund rundt om Three.js + knapper -->
    <div class="relative w-full max-w-xl mx-auto">

      <!-- Three.js scene (DRONEN) -->
      <div class="relative w-full max-w-xl mx-auto">
      <ThreeScene />

      <!-- TOP knapper (skjules når "Resultat" vælges) -->
    <div
  id="top-ui"
  class="hidden absolute top-3 left-1/2 -translate-x-1/2
         flex flex-row items-center justify-center gap-2 z-10"
>
      <button id="btn-lazor" class="chart-btn mode-btn font-ui inline-flex items-center justify-center h-9 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm">
      Laser
    </button>
    <button id="btn-ring" class="chart-btn mode-btn font-ui inline-flex items-center justify-center h-9 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm">
      Rundbånd
    </button>
    <button id="btn-arme" class="chart-btn mode-btn font-ui inline-flex items-center justify-center h-9 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm">
      Arme
    </button>
    <button id="btn-luft" class="chart-btn mode-btn font-ui inline-flex items-center justify-center h-9 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm">
      Lufttrykker
    </button>
  </div>


    <!-- Resultat knapper -->
<div
  id="result-ui"
  class="hidden absolute top-3 left-1/2 -translate-x-1/2 flex flex-row items-center justify-center gap-2 z-10"
>
       <button id="btn-torus" class="chart-btn mode-btn font-ui inline-flex items-center justify-center h-9 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm">
        Donut</button>
  <button id="btn-sphere" class="chart-btn mode-btn font-ui inline-flex items-center justify-center h-9 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm">
    Kugle</button>
  <button id="btn-knot" class="chart-btn mode-btn font-ui inline-flex items-center justify-center h-9 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm">
    Knude</button>
    <button id="btn-firkant" class="chart-btn mode-btn font-ui inline-flex items-center justify-center h-9 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm">
      Firkant</button>
</div>

<script is:inline>
  // Kun de 8 valg-knapper
  const modeButtons = document.querySelectorAll(".mode-btn");

  modeButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      // Nulstil ALLE til standardfarve
      modeButtons.forEach(b => {
        b.classList.remove("bg-[#EEB770]");
        b.classList.add("bg-[#E3A14B]");
      });

      // Marker KUN den klikkede
      btn.classList.remove("bg-[#E3A14B]");
      btn.classList.add("bg-[#EEB770]");
    });
  });
</script>



      <!-- bund knapper -->
      <div class="absolute bottom-3 right-3 z-10 flex gap-2">
       <button id="btn-reset" class="chart-btn font-ui inline-flex items-center justify-center h-9 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm">
      Tilbage
    </button>
    <button id="btn-resultat" class="px-3 font-ui py-2 rounded h-9 px-3 rounded-md
           bg-[#E3A14B] text-[#26264C] text-sm font-medium
           border border-[#26264C]/20 shadow-sm">
      Resultat
    </button>
      </div>
    </div>

    <h2 class="text-2xl font-heading mt-3 text-[#26264C] font-bold">Hvad er DroneFGN26?</h2>
    <h1 class="text-sm font-body text-[#26264C]">DroneFGN26 er et teknologisk udviklingsprojekt med fokus på design og implementering af koordinerede droneshows som et bæredygtigt alternativ til traditionelt fyrværkeri. Projektet arbejder med autonome multirotor-droner, der via centraliseret styring, positionsdata (GNSS) og realtidskommunikation kan udføre præcise formationer og lyssekvenser i luftrummet. Systemet er udviklet med energieffektivitet, genanvendelige komponenter og støjreduktion som centrale parametre. Formålet er at demonstrere, hvordan avanceret drone-teknologi, softwarestyret koreografi og LED-baserede lyssystemer kan skabe sikre, skalerbare og miljøvenlige visuelle events uden partikeludledning, brandrisiko eller eksplosive materialer.</h1>
  </main>

</Layout>